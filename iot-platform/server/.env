# Server Port & Environment
PORT=3001
NODE_ENV=development

# PostgreSQL Database Connection
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Google OAuth Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# JWT Authentication
JWT_SECRET=YOUR_SECURE_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=7d

# Client Application URL (for post-Google login redirection)
CLIENT_URL=http://localhost:5173

# CORS Allowed Origins (Comma-separated list)
# Add Cloudflare tunnel URL here if applicable
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Backend Server URL for ESP32 Microcontrollers (Direct Local IP)
# ESP32 operates on the same local LAN, using direct IP instead of public tunnels
ESP_SERVER_URL=http://YOUR_LOCAL_SERVER_IP:3001

# Telemetry Gap Threshold (in minutes)
MISSING_DATA_THRESHOLD_MINUTES=10